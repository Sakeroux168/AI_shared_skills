{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sakeroux168/AI_shared_skills/registry/source.schema.json",
  "title": "AI shared source registry",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "repository",
          "branch",
          "commit",
          "sync_mode",
          "license",
          "author",
          "snapshot",
          "update_strategy"
        ],
        "properties": {
          "id": {"type": "string"},
          "repository": {"type": "string"},
          "branch": {"type": "string"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "sync_mode": {"enum": ["review", "manual", "disabled"]},
          "license": {
            "type": "object",
            "required": ["repository_license", "content_rights"],
            "properties": {
              "repository_license": {
                "type": "object",
                "required": ["spdx", "file", "verified_from"],
                "properties": {
                  "spdx": {"type": "string"},
                  "copyright": {"type": "string"},
                  "file": {"type": "string"},
                  "verified_from": {"type": "string"}
                }
              },
              "content_rights": {
                "type": "object",
                "required": [
                  "status",
                  "upstream_disclaimer",
                  "scope",
                  "attribution",
                  "commercial_use"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "repository-license-applies",
                      "mixed",
                      "separate-or-unknown"
                    ]
                  },
                  "upstream_disclaimer": {"type": "string"},
                  "scope": {"type": "string"},
                  "attribution": {"type": "string"},
                  "commercial_use": {"type": "string"}
                }
              }
            }
          },
          "author": {"type": "string"},
          "snapshot": {"type": "object"},
          "update_strategy": {"type": "object"}
        }
      }
    }
  }
}
